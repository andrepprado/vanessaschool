{
    "cleanUrls":  true,
    "trailingSlash":  false,
    "rewrites":  [
                     {
                         "source":  "/hf-kokoro/:path*",
                         "destination":  "https://huggingface.co/:path*"
                     }
                 ],
    "headers":  [
                    {
                        "source":  "/hf-kokoro/:path*",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "public, max-age=31536000, immutable"
                                        },
                                        {
                                            "key":  "CDN-Cache-Control",
                                            "value":  "public, max-age=31536000, immutable"
                                        },
                                        {
                                            "key":  "Vercel-CDN-Cache-Control",
                                            "value":  "public, max-age=31536000, immutable"
                                        }
                                    ]
                    },
                    {
                        "source":  "/models/(.*)",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "public, max-age=31536000, immutable"
                                        }
                                    ]
                    },
                    {
                        "source":  "/wasm/(.*)",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "public, max-age=31536000, immutable"
                                        }
                                    ]
                    }
                ]
}